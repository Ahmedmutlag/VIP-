<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#7C3AED"
        android:gravity="center"
        android:elevation="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نزلها بلس 🎬"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ── Scrollable content ─────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- URL input card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصق رابط الفيديو"
                    android:textColor="#7C3AED"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/urlInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#EEE9FF"
                        android:hint="https://www.tiktok.com/..."
                        android:textColorHint="#AAAAAA"
                        android:textSize="13sp"
                        android:textColor="#111111"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:gravity="center_vertical"/>

                    <Button
                        android:id="@+id/pasteBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="📋"
                        android:textSize="18sp"
                        android:padding="0dp"
                        android:backgroundTint="#7C3AED"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
            </LinearLayout>

            <!-- Analyze button -->
            <Button
                android:id="@+id/analyzeBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="🔍  تحليل الرابط"
                android:backgroundTint="#7C3AED"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Status -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textSize="13sp"
                android:visibility="gone"/>

            <ProgressBar
                android:id="@+id/loadingBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <!-- ── Format section ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/formatSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/videoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="14dp"/>

                <!-- Video / Audio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnVideo"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="🎬  فيديو"
                        android:backgroundTint="#7C3AED"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/btnAudio"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="🎵  صوت"
                        android:backgroundTint="#7C3AED"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:alpha="0.45"/>

                </LinearLayout>

                <!-- Quality chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/qualitySection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"/>
                </HorizontalScrollView>

                <!-- Download button -->
                <Button
                    android:id="@+id/downloadBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="⬇️  تحميل"
                    android:backgroundTint="#22C55E"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- ── Progress ───────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/progressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:text="⬇️ جاري التحميل..."/>

                <ProgressBar
                    android:id="@+id/downloadProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"/>

            </LinearLayout>

            <!-- Counter -->
            <TextView
                android:id="@+id/downloadCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#888888"/>

            <!-- Watch ad -->
            <Button
                android:id="@+id/watchAdBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="📺  شاهد إعلاناً للحصول على تحميل مجاني"
                android:backgroundTint="#7C3AED"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone"/>

            <!-- Subscribe -->
            <Button
                android:id="@+id/subscribeBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:text="💎  اشترك للتحميل غير المحدود"
                android:backgroundTint="#F59E0B"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>

    <!-- Banner Ad -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/bannerAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-9098461798177099/2852599432"/>

</LinearLayout>
