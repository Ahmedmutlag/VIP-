<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F3FF">

    <!-- ── Scrollable content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#7C3AED"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬇"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نزلها بلس"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- URL Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:layout_marginTop="16dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:padding="16dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصق رابط الفيديو"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="https://..."
                    android:inputType="textUri"
                    android:textSize="14sp"
                    android:textColor="#1F1F2E"
                    android:textColorHint="#9CA3AF"
                    android:background="#EEE9FF"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:gravity="center_vertical|start" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="end">

                    <Button
                        android:id="@+id/pasteBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="📋 لصق"
                        android:textSize="14sp"
                        android:textColor="#7C3AED"
                        android:background="#EEE9FF"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="10dp" />

                    <Button
                        android:id="@+id/fetchBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="جلب المعلومات ←"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:background="#7C3AED"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/loadingSpinner"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:indeterminateTint="#7C3AED"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp" />

            <!-- Error Box -->
            <TextView
                android:id="@+id/errorBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="10dp"
                android:background="#FEE2E2"
                android:padding="14dp"
                android:textColor="#DC2626"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Result Card -->
            <LinearLayout
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:layout_marginTop="14dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:padding="16dp"
                android:elevation="4dp"
                android:visibility="gone">

                <!-- Thumbnail + info row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:id="@+id/thumbnail"
                        android:layout_width="110dp"
                        android:layout_height="70dp"
                        android:scaleType="centerCrop"
                        android:background="#E5E7EB"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/platformBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#EEE9FF"
                            android:textColor="#7C3AED"
                            android:textSize="11sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/videoTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="#1F1F2E"
                            android:textStyle="bold"
                            android:maxLines="3"
                            android:ellipsize="end" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اختر الجودة"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="10dp" />

                <!-- Format buttons (filled dynamically) -->
                <LinearLayout
                    android:id="@+id/formatsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Download Progress -->
            <LinearLayout
                android:id="@+id/progressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:layout_marginTop="14dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:padding="16dp"
                android:elevation="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⬇ جاري التحميل..."
                        android:textSize="14sp"
                        android:textColor="#1F1F2E"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/progressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="14sp"
                        android:textColor="#7C3AED"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/downloadProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#7C3AED"
                    android:progressBackgroundTint="#EEE9FF" />

            </LinearLayout>

            <!-- Hint card (shown when no result yet) -->
            <LinearLayout
                android:id="@+id/hintCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗"
                    android:textSize="48sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصق رابط أي فيديو من الإنترنت"
                    android:textSize="15sp"
                    android:textColor="#6B7280"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+50 منصة مدعومة"
                    android:textSize="13sp"
                    android:textColor="#A78BFA"
                    android:gravity="center"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Banner Ad — fixed at bottom -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/bannerAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-9098461798177099/2852599432" />

</LinearLayout>
